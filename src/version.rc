#include <windows.h>

#define IDI_NOTEPAD_REPLACER 101

IDI_NOTEPAD_REPLACER ICON "../replacer.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Notepad Replacer\0"
            VALUE "FileDescription", "Notepad Replacer Launcher\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "NotepadReplacerLauncher\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Notepad Replacer contributors\0"
            VALUE "OriginalFilename", "NotepadReplacerLauncher.exe\0"
            VALUE "ProductName", "Notepad Replacer\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
