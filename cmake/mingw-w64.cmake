set(CMAKE_SYSTEM_NAME Windows)

set(MINGW_ARCH "x86_64" CACHE STRING "MinGW target architecture (x86_64 or i686)")
if(NOT MINGW_ARCH MATCHES "^(x86_64|i686)$")
    message(FATAL_ERROR "MINGW_ARCH must be x86_64 or i686")
endif()
set(CMAKE_CXX_COMPILER ${MINGW_ARCH}-w64-mingw32-g++-posix)
set(CMAKE_RC_COMPILER ${MINGW_ARCH}-w64-mingw32-windres)
set(CMAKE_FIND_ROOT_PATH /usr/${MINGW_ARCH}-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
